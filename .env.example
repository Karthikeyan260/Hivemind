# Template only — real values go in .env.local (git-ignored) and in Vercel → Settings → Environment Variables.
# Everything here is server-only except the NEXT_PUBLIC_* lines. Full table: README, section 4.

# ── Required ──────────────────────────────────────────────────────────────────
# Supabase → Project Settings → API Keys. Use the SECRET key (sb_secret_...), never expose it.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=

# Access gate. Leave empty locally (no password). REQUIRED on Vercel — the app refuses to run without it.
APP_PASSWORD=

# Main AI + embeddings.
GEMINI_API_KEY=

# Any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used by the scheduler (cron-job.org → /api/cron/notify, header "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# Web Push keys: npx web-push generate-vapid-keys
# Without them there are no notifications (the scheduler still runs the other jobs).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ── Fallback AI providers (each is skipped when its key is empty) ─────────────
# Order: gemini → nvidia → openrouter → mistral → groq
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# Optional model overrides (defaults shown; free providers retire models often)
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# MISTRAL_MODEL=ministral-14b-latest
# GROQ_MODEL=qwen/qwen3.8-27b

# ── Portfolio / sources ───────────────────────────────────────────────────────
# Portfolio MCP endpoint, e.g. https://portfolio-mcp.<you>.workers.dev/mcp
# Empty = read the same data files from GitHub instead.
PORTFOLIO_MCP_URL=
# PORTFOLIO_DATA_REPO=Karthikeyan260/Portfolio-mcp

# ── Place, time, taste (optional) ─────────────────────────────────────────────
# Public URL of the deployed app (used when the server calls itself). Defaults to the request origin.
# APP_URL=https://your-app.vercel.app
# Local hour the morning brief opens, and the time zone for reminders and daily jobs.
# BRIEF_HOUR=8
# HOME_TZ=Asia/Kolkata
# City used when you ask about the weather without naming a place (Open-Meteo).
HOME_CITY=Chennai
# MUSIC_LANGUAGE=tamil
# Gemini models used for Google Search grounding. On the free tier only 2.5 models have search quota.
WEB_SEARCH_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# ── Extra services (optional) ─────────────────────────────────────────────────
# Cloud browser for Web tasks.
# STEEL_API_KEY=
# Job search on the Career page (JSearch on RapidAPI).
# RAPIDAPI_KEY=
# Better video search.
# YOUTUBE_API_KEY=
# TURN relay for calls, games and Friends Theatre behind strict networks (Cloudflare or Metered).
# TURN_KEY_ID=
# TURN_KEY_API_TOKEN=
# METERED_DOMAIN=
# METERED_API_KEY=
# Optional signing keys (32+ chars). If unset, random ones are made and kept in the private bucket.
# SESSION_SECRET=
# PEER_SECRET=
